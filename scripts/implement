#!/usr/bin/env bash
# implement — Start an implementation session for a feature or issue spec
#
# Usage: ./implement <ID> [--tool codex|gemini|aider] [--model <model>] [--plan [--force]]
#
#   <ID>          Feature ID (F1), issue ID (I4 = GitHub issue #4), or a phase of a phased
#                 feature (F4.2 = phase 2 of F4). A phased spec has a `**Phases:** N` header and
#                 `## Phase N` sections; the implementor is given only the shared sections plus the
#                 requested phase, and per-phase plan/progress/ledger files (plans/F4.2-*).
#   --plan        Stage 1: write implementation plan only, no code
#   --force       Overwrite existing plan (use with --plan)
#   --skip-entry-check   Phase N>1: do not require phase N-1 to be closed (ledger Passed + log entry)
#   --skip-preflight     Do not run PREFLIGHT_CMD from .implement.conf
#   --tool        codex, gemini, or aider (overrides IMPLEMENT_TOOL env and .implement.conf)
#   --model       Model override (overrides IMPLEMENT_MODEL env and .implement.conf)
#
# Stages:
#   1. Plan:      ./implement F1 --plan
#                 → writes plans/F1-plan.md, then exits
#                 → run /review-plan F1 in Claude Code to review and approve
#   2. Implement: ./implement F1
#                 → if plans/F1-plan-approved.md exists, uses it automatically
#                 → Full-level spec without an approved plan is blocked
#                 → implementor runs tests and fixes failures as part of the session
#   3. Verify:    ./check-tests  (pre-commit sanity check after /review)
#
# All three tools run in interactive mode: codex and gemini accept an initial prompt
# then stay interactive; aider does the same. Type 'continue' to proceed after each response.
#
# Tool selection: --tool arg > IMPLEMENT_TOOL env > .implement.conf > error
# Model selection: --model arg > IMPLEMENT_MODEL env > .implement.conf
#
# For aider, AGENT.md and CODING.md are auto-loaded via .aider.conf.yml.
# For Gemini CLI, AGENT.md and CODING.md are auto-loaded via .gemini/settings.json.
# For Codex, AGENTS.md is auto-loaded; prompt also explicitly requires AGENT.md + CODING.md.
#
# Configuration (in .implement.conf):
#   tool=codex
#   model=gpt-5.4
#   TEST_CMD=npm --prefix client test -- --watchAll=false
#   PREFLIGHT_CMD=curl -sf http://localhost:8000/health/   # optional; must succeed before tests run
#   PREFLIGHT_HELP=Start the stack first: ./dsc.sh start all  # optional; shown when preflight fails
#   KNOWN_FILE=client/known-test-failures.txt
#   SPEC_FILE_PATTERN=client|supabase/migrations
#   AIDER_REFERENCE_FILE=client/components/__tests__/MyFile-test.tsx   # optional

set -euo pipefail

SPEC_ID=""
TOOL=""
MODEL=""
PLAN_MODE=false
FORCE=false
SKIP_ENTRY=false
SKIP_PREFLIGHT=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    [FI][0-9]*)  SPEC_ID="$1"; shift;;
    --tool)      TOOL="$2"; shift 2;;
    --model)     MODEL="$2"; shift 2;;
    --plan)      PLAN_MODE=true; shift;;
    --force)     FORCE=true; shift;;
    --skip-entry-check) SKIP_ENTRY=true; shift;;
    --skip-preflight)   SKIP_PREFLIGHT=true; shift;;
    -h|--help)
      echo "Usage: ./implement <ID> [--tool codex|gemini|aider] [--model <model>] [--plan [--force]]"
      echo ""
      echo "  ID         F1 (feature), I4 (issue — matches GitHub issue #4) or F4.2 (phase 2 of F4)"
      echo "  --plan     Stage 1: write plan only (no code)"
      echo "  --force    Overwrite existing plan"
      echo ""
      echo "Tool selection (required unless configured):"
      echo "  --tool     codex, gemini, or aider"
      echo "             Overrides: IMPLEMENT_TOOL env var or tool= in .implement.conf"
      echo "  --model    Model to use (e.g. codex-mini-latest, claude-sonnet-4-6)"
      echo "             Overrides: IMPLEMENT_MODEL env var or model= in .implement.conf"
      exit 0;;
    *)
      echo "Unknown argument: $1"
      echo "Usage: ./implement <ID> [--tool codex|gemini|aider] [--model <model>] [--plan [--force]]"
      exit 1;;
  esac
done

if [[ -z "$SPEC_ID" ]]; then
  echo "Usage: ./implement <ID> [--tool codex|gemini|aider] [--model <model>] [--plan [--force]]"
  echo ""
  echo "  ID must be a feature ID (F1), issue ID (I4) or a phase (F4.2)"
  exit 1
fi

# Phase syntax: F4.2 = phase 2 of feature F4. The spec, design and issue belong to F4; the plan,
# progress file and review ledger belong to the phase (plans/F4.2-*).
BASE_ID="$SPEC_ID"
PHASE=""
if [[ "$SPEC_ID" =~ ^([FI][0-9]+)\.([0-9]+)$ ]]; then
  BASE_ID="${BASH_REMATCH[1]}"
  PHASE="${BASH_REMATCH[2]}"
fi

# Resolve tool: --tool arg > IMPLEMENT_TOOL env > .implement.conf > error
TOOL_SOURCE=""
CONFIG_FILE=".implement.conf"
CONFIG_TOOL=""
CONFIG_MODEL=""
TEST_CMD=""
KNOWN_FILE=""
SPEC_FILE_PATTERN=""
AIDER_REFERENCE_FILE=""
PREFLIGHT_CMD=""
PREFLIGHT_HELP=""

if [[ -f "$CONFIG_FILE" ]]; then
  CONFIG_TOOL=$(grep '^tool=' "$CONFIG_FILE" | head -1 | sed 's/^tool=//' | tr -d '[:space:]' || true)
  CONFIG_MODEL=$(grep '^model=' "$CONFIG_FILE" | head -1 | sed 's/^model=//' | tr -d '[:space:]' || true)
  TEST_CMD=$(grep '^TEST_CMD=' "$CONFIG_FILE" | head -1 | sed 's/^TEST_CMD=//' || true)
  KNOWN_FILE=$(grep '^KNOWN_FILE=' "$CONFIG_FILE" | head -1 | sed 's/^KNOWN_FILE=//' | tr -d '[:space:]' || true)
  SPEC_FILE_PATTERN=$(grep '^SPEC_FILE_PATTERN=' "$CONFIG_FILE" | head -1 | sed 's/^SPEC_FILE_PATTERN=//' | tr -d '[:space:]' || true)
  PREFLIGHT_CMD=$(grep '^PREFLIGHT_CMD=' "$CONFIG_FILE" | head -1 | sed 's/^PREFLIGHT_CMD=//' || true)
  PREFLIGHT_HELP=$(grep '^PREFLIGHT_HELP=' "$CONFIG_FILE" | head -1 | sed 's/^PREFLIGHT_HELP=//' || true)
  AIDER_REFERENCE_FILE=$(grep '^AIDER_REFERENCE_FILE=' "$CONFIG_FILE" | head -1 | sed 's/^AIDER_REFERENCE_FILE=//' | tr -d '[:space:]' || true)
fi

if [[ -z "$TOOL" ]]; then
  if [[ -n "${IMPLEMENT_TOOL:-}" ]]; then
    TOOL="$IMPLEMENT_TOOL"
    TOOL_SOURCE="env"
  elif [[ -n "$CONFIG_TOOL" ]]; then
    TOOL="$CONFIG_TOOL"
    TOOL_SOURCE="config"
  else
    echo "Error: No tool specified."
    echo ""
    echo "Specify one of:"
    echo "  --tool codex|gemini|aider         (CLI argument)"
    echo "  IMPLEMENT_TOOL=codex              (environment variable)"
    echo "  tool=codex in .implement.conf     (project config)"
    exit 1
  fi
else
  TOOL_SOURCE="arg"
fi

# Resolve model: --model arg > IMPLEMENT_MODEL env > .implement.conf
if [[ -z "$MODEL" ]]; then
  if [[ -n "${IMPLEMENT_MODEL:-}" ]]; then
    MODEL="$IMPLEMENT_MODEL"
  elif [[ -n "$CONFIG_MODEL" ]]; then
    MODEL="$CONFIG_MODEL"
  fi
fi

# Validate required config
if [[ -z "$TEST_CMD" ]]; then
  echo "Error: TEST_CMD not set in $CONFIG_FILE"
  echo "Add a line like: TEST_CMD=npm test -- --watchAll=false"
  exit 1
fi
if [[ -z "$KNOWN_FILE" ]]; then
  KNOWN_FILE="known-test-failures.txt"
fi
if [[ -z "$SPEC_FILE_PATTERN" ]]; then
  echo "Error: SPEC_FILE_PATTERN not set in $CONFIG_FILE"
  echo "Add a line like: SPEC_FILE_PATTERN=src|migrations"
  exit 1
fi

# Find the spec file
SPEC_FILE=$(find specs -name "${BASE_ID}-*.md" 2>/dev/null | head -1)
if [[ -z "$SPEC_FILE" ]]; then
  echo "Error: No spec file found for ${BASE_ID} in specs/"
  echo "Available specs:"
  ls specs/*.md 2>/dev/null | sed 's/^/  /' || echo "  (none)"
  exit 1
fi
FULL_SPEC_FILE="$SPEC_FILE"

# Phased specs: `**Phases:** N` in the header, `## Phase N` sections in the body.
SPEC_PHASES=$(grep -oP '(?<=\*\*Phases:\*\* )[0-9]+' "$FULL_SPEC_FILE" 2>/dev/null | head -1 || true)
if [[ -n "$SPEC_PHASES" ]] && [[ -z "$PHASE" ]]; then
  echo "Error: ${BASE_ID} is a phased feature (${SPEC_PHASES} phases); implement one phase at a time."
  echo "  ./implement ${BASE_ID}.1${PLAN_MODE:+ --plan}"
  exit 1
fi
if [[ -n "$PHASE" ]]; then
  if [[ -z "$SPEC_PHASES" ]]; then
    echo "Error: ${FULL_SPEC_FILE} has no '**Phases:** N' header, so ${SPEC_ID} is not a valid phase ID."
    exit 1
  fi
  if (( PHASE < 1 || PHASE > SPEC_PHASES )); then
    echo "Error: ${BASE_ID} has ${SPEC_PHASES} phases; ${SPEC_ID} is out of range."
    exit 1
  fi
  HEADINGS=$(grep -cE '^## Phase [0-9]+' "$FULL_SPEC_FILE" || true)
  if [[ "$HEADINGS" != "$SPEC_PHASES" ]]; then
    echo "Error: ${FULL_SPEC_FILE} declares ${SPEC_PHASES} phases but has ${HEADINGS} '## Phase N' sections."
    exit 1
  fi
  # The phase's block, to check that its detail has been written (see /spec F4.N).
  PHASE_BLOCK=$(awk -v want="$PHASE" '
    /^## / { on = 0; if ($0 ~ /^## Phase [0-9]+/) { n = $3; sub(/[^0-9].*/, "", n); if (n == want) on = 1 } }
    on { print }' "$FULL_SPEC_FILE")
  if [[ -z "$PHASE_BLOCK" ]]; then
    echo "Error: no '## Phase ${PHASE}' section in ${FULL_SPEC_FILE}."
    exit 1
  fi
  if grep -q '<!-- detail: pending' <<<"$PHASE_BLOCK"; then
    echo "Error: Phase ${PHASE} of ${BASE_ID} is still marked '<!-- detail: pending -->'."
    echo "  Its file and test lists have not been written yet. Run /spec ${SPEC_ID} in Claude Code first."
    exit 1
  fi
  # Entry check: the previous phase must be closed (ledger Passed and a 'Phase N closed' log entry).
  if (( PHASE > 1 )) && [[ "$SKIP_ENTRY" == false ]]; then
    PREV=$((PHASE - 1))
    PREV_LEDGER="plans/${BASE_ID}.${PREV}-review.md"
    LOG_FILE="plans/${BASE_ID}-log.md"
    if ! grep -q '\*\*Status:\*\* Passed' "$PREV_LEDGER" 2>/dev/null \
       || ! grep -q "Phase ${PREV} closed" "$LOG_FILE" 2>/dev/null; then
      echo "Error: phase ${PREV} of ${BASE_ID} is not closed, so phase ${PHASE} cannot start."
      echo "  Needed: ${PREV_LEDGER} with Status: Passed, and a '## <date> — Phase ${PREV} closed' entry in ${LOG_FILE}."
      echo "  Close it with /complete ${BASE_ID}.${PREV} in Claude Code (or pass --skip-entry-check to override)."
      exit 1
    fi
  fi
  # Give the implementor only the shared sections plus this phase.
  mkdir -p .implement-cache
  SPEC_FILE=".implement-cache/${SPEC_ID}-spec.md"
  awk -v want="$PHASE" '
    /^## / { skip = 0; if ($0 ~ /^## Phase [0-9]+/) { n = $3; sub(/[^0-9].*/, "", n); if (n != want) skip = 1 } }
    !skip { print }' "$FULL_SPEC_FILE" > "$SPEC_FILE"
fi

PLAN_FILE="plans/${SPEC_ID}-plan.md"
APPROVED_PLAN_FILE="plans/${SPEC_ID}-plan-approved.md"
PROGRESS_FILE="plans/${SPEC_ID}-progress.md"

# Always ensure plans/ directory exists
mkdir -p plans

# Guard: if a non-empty plan already exists and --force was not passed, stop and guide the user.
if [[ "$PLAN_MODE" == true ]] && [[ "$FORCE" == false ]]; then
  if [[ -f "$PLAN_FILE" ]] && [[ -s "$PLAN_FILE" ]]; then
    echo "Plan already exists: $PLAN_FILE"
    echo ""
    if [[ "$SPEC_FILE" -nt "$PLAN_FILE" ]]; then
      echo "  ⚠  Spec is newer than the plan — the spec may have changed since the plan was written."
      echo "     Consider regenerating with --force to pick up spec changes."
    fi
    echo "Next step:  /review-plan ${SPEC_ID} in Claude Code to review, iterate, and approve."
    echo "Regenerate: ./implement ${SPEC_ID} --plan --force  (overwrites existing plan)"
    exit 0
  fi
fi

# Extract review level from spec header
REVIEW_LEVEL=$(grep -oP '(?<=\*\*Review Level:\*\* )\S+' "$FULL_SPEC_FILE" 2>/dev/null | head -1 || true)

# Auto-detect approved plan
HAS_APPROVED_PLAN=false
if [[ -f "$APPROVED_PLAN_FILE" ]]; then
  HAS_APPROVED_PLAN=true
fi

# Enforce: Full-level spec in implement mode requires an approved plan
if [[ "$PLAN_MODE" == false ]] && [[ "$REVIEW_LEVEL" == "Full" ]] && [[ "$HAS_APPROVED_PLAN" == false ]]; then
  echo "Error: ${SPEC_ID} is a Full-level spec and requires an approved plan."
  echo ""
  echo "  Step 1: ./implement ${SPEC_ID} --plan          # write the plan"
  echo "  Step 2: /review-plan ${SPEC_ID}               # review and approve in Claude Code"
  echo "  Step 3: ./implement ${SPEC_ID}                # implement with approved plan"
  exit 1
fi

echo "Spec:  $SPEC_FILE"
if [[ -n "$PHASE" ]]; then
  echo "Phase: ${PHASE} of ${SPEC_PHASES} (${FULL_SPEC_FILE}, sliced)"
fi
echo "Tool:  $TOOL [$TOOL_SOURCE]${MODEL:+ (model: $MODEL)}"
if [[ -n "$REVIEW_LEVEL" ]]; then
  echo "Review Level: $REVIEW_LEVEL"
fi
if [[ "$HAS_APPROVED_PLAN" == true ]] && [[ "$PLAN_MODE" == false ]]; then
  echo "Plan:  $APPROVED_PLAN_FILE (auto-detected)"
fi
echo ""

# Preflight: e.g. the dev stack is up. Fails before the implementor starts, so it never has to guess.
if [[ "$PLAN_MODE" == false ]] && [[ -n "$PREFLIGHT_CMD" ]] && [[ "$SKIP_PREFLIGHT" == false ]]; then
  echo "Preflight: $PREFLIGHT_CMD"
  if ! bash -c "$PREFLIGHT_CMD" >/dev/null 2>&1; then
    echo "Error: preflight failed."
    [[ -n "$PREFLIGHT_HELP" ]] && echo "  $PREFLIGHT_HELP"
    echo "  (pass --skip-preflight to run anyway)"
    exit 1
  fi
  echo ""
fi

# Notes appended to the implementor's prompt.
PHASE_NOTE=""
if [[ -n "$PHASE" ]]; then
  PHASE_NOTE=" This is phase ${PHASE} of ${BASE_ID}. The spec file you were given contains only this phase; implement phase ${PHASE} only, and do not start, prepare or partially implement any other phase. Use ${SPEC_ID} wherever AGENT.md says F[N]. When phase ${PHASE} is done, STOP; do not continue."
fi
PREFLIGHT_NOTE=""
if [[ -n "$PREFLIGHT_CMD" ]]; then
  PREFLIGHT_NOTE=" Before your final test run, run the preflight check '${PREFLIGHT_CMD}'. If it fails, it may be your sandbox blocking a local connection, not the service: request elevated execution for that same command and retry once. Only if the retry also fails or is refused, stop and tell the user${PREFLIGHT_HELP:+ (${PREFLIGHT_HELP})}. Never skip or deselect tests to get around it."
fi
REPORT_NOTE=" End your final message with the End-of-Run Report in the exact format defined in AGENT.md, including the exact next steps for the user."
SUFFIX="${PHASE_NOTE}${PREFLIGHT_NOTE}${REPORT_NOTE}"
PLAN_SUFFIX="${PHASE_NOTE}"

# Capture test baseline before implementation begins (skip during plan-only mode)
# --if-stale skips the re-run when the saved result is still fresh (e.g. immediately after a
# review-impl run, or back-to-back implement passes with no source changes in between).
if [[ "$PLAN_MODE" == false ]]; then
  if [[ -f "./check-tests" ]]; then
    echo "Capturing test baseline before implementation..."
    if ! ./check-tests --if-stale 2>&1; then
      echo ""
      echo "⚠  Unexpected test failures exist before implementation starts."
      echo "   Run /fix-baseline in Claude Code to resolve pre-existing failures first,"
      echo "   or add them to $KNOWN_FILE if they are acceptable."
      echo "   Continuing anyway — the implementor will see these in their test run."
      echo ""
    else
      echo ""
    fi
  fi
fi


case "$TOOL" in
  codex)
    # AGENTS.md is auto-loaded by Codex; prompt also explicitly requires AGENT.md + CODING.md
    # to guarantee both are loaded regardless of auto-discovery behavior.
    # Runs in interactive mode (no exec/--full-auto) so sessions can be continued
    # by typing 'continue' rather than restarting from scratch after a timeout.
    CONTEXT_PREFIX="First read AGENT.md and CODING.md in full. Confirm you have read both before making any changes. "
    CODEX_ARGS=()
    if [[ -n "$MODEL" ]]; then
      CODEX_ARGS+=(-m "$MODEL")
    fi

    if [[ "$PLAN_MODE" == true ]]; then
      PROMPT="${CONTEXT_PREFIX}Read $SPEC_FILE. Write an implementation plan to $PLAN_FILE using the Plan Mode section format in AGENT.md. Do not write any code. After writing the plan, output a summary.${PLAN_SUFFIX}"
    elif [[ "$HAS_APPROVED_PLAN" == true ]]; then
      PROMPT="${CONTEXT_PREFIX}The approved plan in $APPROVED_PLAN_FILE has been reviewed and approved by Claude and the user. Check $PROGRESS_FILE for a progress log — if present, read the completed files to confirm their state and continue from where the previous session left off; otherwise start fresh. Maintain $PROGRESS_FILE throughout: append a progress entry after each file. After all files are implemented, run '$TEST_CMD' and fix any failing tests and rerun only until they pass -- if the initial run already passes, do not run the full suite again. List all files changed and paste the final test output when done.${SUFFIX}"
    else
      PROMPT="${CONTEXT_PREFIX}Implement $SPEC_FILE. Maintain $PROGRESS_FILE throughout: append a progress entry after completing each file. After all files are implemented, run '$TEST_CMD' and fix any failing tests and rerun only until they pass -- if the initial run already passes, do not run the full suite again. List all files changed and paste the final test output when done.${SUFFIX}"
    fi
    echo "Running: codex (interactive)${MODEL:+ (model: $MODEL)}"
    echo "NOTE: Codex will process the initial message then stay interactive."
    echo "      Type 'continue' after each response to proceed with remaining files."
    echo ""
    codex "${CODEX_ARGS[@]}" "$PROMPT"
    ;;

  gemini)
    # AGENT.md and CODING.md are auto-loaded via .gemini/settings.json
    if [[ "$PLAN_MODE" == true ]]; then
      PROMPT="Read $SPEC_FILE. Write an implementation plan to $PLAN_FILE using the Plan Mode section format in AGENT.md. Do not write any code. After writing the plan, output a summary and wait for my approval. Type \"approved\" to proceed with implementation.${PLAN_SUFFIX}"
    elif [[ "$HAS_APPROVED_PLAN" == true ]]; then
      PROMPT="The approved plan in $APPROVED_PLAN_FILE has been reviewed and approved by Claude and the user. Check $PROGRESS_FILE for a progress log — if present, read the completed files to confirm their state and continue from where the previous session left off; otherwise start fresh. Maintain $PROGRESS_FILE throughout: append a progress entry after each file. After all files are implemented, run '$TEST_CMD' and fix any failing tests and rerun only until they pass -- if the initial run already passes, do not run the full suite again. List all files changed and paste the final test output when done.${SUFFIX}"
    else
      PROMPT="Implement $SPEC_FILE. Maintain $PROGRESS_FILE throughout: append a progress entry after completing each file. After all files are implemented, run '$TEST_CMD' and fix any failing tests and rerun only until they pass -- if the initial run already passes, do not run the full suite again. List all files changed and paste the final test output when done.${SUFFIX}"
    fi
    echo "Running: gemini \"$PROMPT\""
    echo ""
    gemini "$PROMPT"
    ;;

  aider)
    # AGENT.md and CODING.md are auto-loaded via .aider.conf.yml
    # --yes: auto-accept all file-addition prompts (no interactive confirmations)
    CMD_ARGS=(--yes)
    if [[ -n "$MODEL" ]]; then
      CMD_ARGS+=(--model "$MODEL")
    fi

    if [[ "$PLAN_MODE" == true ]]; then
      # Plan mode: write plan file only, no code changes.
      # Inline the spec content in the message rather than using --read so that
      # aider does not recognise the spec's file paths as repo files and prompt
      # to add them to the chat (which interferes with the plan-file write).
      touch "$PLAN_FILE"
      CMD_ARGS+=("$PLAN_FILE")
      CMD_ARGS+=(--message "$(printf 'Feature spec for %s:\n\n%s\n\nTask: Write an implementation plan to %s following the Plan Mode format in AGENT.md.\nRules:\n- Write ONLY to %s\n- Do NOT add any other files to the chat\n- Do NOT write any implementation code\n- After writing the plan file, print a one-paragraph summary and stop' \
        "$SPEC_ID" "$(< "$SPEC_FILE")" "$PLAN_FILE" "$PLAN_FILE")")
      echo "Running: aider (plan mode — spec inlined, writing to $PLAN_FILE)"
      echo ""
      aider "${CMD_ARGS[@]}"
    else
      # Implementation mode: interactive session
      CMD_ARGS+=(--read "$SPEC_FILE")

      # Load optional reference file for context (e.g. a representative test file)
      if [[ -n "$AIDER_REFERENCE_FILE" ]] && [[ -f "$AIDER_REFERENCE_FILE" ]]; then
        CMD_ARGS+=(--read "$AIDER_REFERENCE_FILE")
      fi

      # Extract all backtick-quoted paths matching SPEC_FILE_PATTERN from the spec
      FILES=$(grep -oP "\`($SPEC_FILE_PATTERN)/[^\`]+\`" "$SPEC_FILE" | tr -d '`' | sort -u)

      if [[ -z "$FILES" ]]; then
        echo "Error: No file paths matching '$SPEC_FILE_PATTERN' found in spec."
        echo "Check Files to Modify, New Files, and Tests to Write sections use backtick-quoted paths."
        exit 1
      fi

      echo "Files from spec:"
      echo "$FILES" | sed 's/^/  /'
      echo ""

      # Pre-create any files that don't exist yet so aider can open them without prompting
      while IFS= read -r f; do
        if [[ ! -f "$f" ]]; then
          mkdir -p "$(dirname "$f")"
          touch "$f"
          echo "  Created (empty): $f"
        fi
      done <<< "$FILES"
      touch "$PROGRESS_FILE"
      echo ""

      while IFS= read -r f; do
        CMD_ARGS+=("$f")
      done <<< "$FILES"

      # Progress file is always editable so aider can write to it
      CMD_ARGS+=("$PROGRESS_FILE")

      # Build the implementation prompt — sent as --message to kick off the session.
      # Aider processes the message and then stays in interactive mode.
      # Type 'continue' after each response to proceed with remaining files.
      if [[ "$HAS_APPROVED_PLAN" == true ]]; then
        IMPL_PROMPT=$(printf 'The following implementation plan has been reviewed and approved by Claude and the user. Follow it exactly. Proceed directly — do not ask for confirmation.\n\n---BEGIN APPROVED PLAN---\n%s\n---END APPROVED PLAN---\n\nCheck %s for a progress log — if present, read the completed files to confirm their state and continue from where the previous session left off; otherwise start fresh. Maintain %s throughout: append a progress entry after each file. After all files are implemented, run '"'"'%s'"'"' and fix any failing tests and rerun only until they pass -- if the initial run already passes, do not run the full suite again. List all files changed and paste the final test output when done.' \
          "$(< "$APPROVED_PLAN_FILE")" "$PROGRESS_FILE" "$PROGRESS_FILE" "$TEST_CMD")
      else
        IMPL_PROMPT=$(printf 'Implement the spec provided in context (read-only). Maintain %s throughout: append a progress entry after completing each file. After all files are implemented, run '"'"'%s'"'"' and fix any failing tests and rerun only until they pass -- if the initial run already passes, do not run the full suite again. List all files changed and paste the final test output when done.' \
          "$PROGRESS_FILE" "$TEST_CMD")
      fi

      CMD_ARGS+=(--message "$IMPL_PROMPT")

      echo "NOTE: Aider will process the initial message then stay interactive."
      echo "      Type 'continue' after each response to proceed with remaining files."
      echo ""
      echo "Running: aider (interactive, initial message set)"
      echo ""
      aider "${CMD_ARGS[@]}"
    fi
    ;;

  claude)
    # Launches claude CLI as a new subprocess — isolated context, no conversation history.
    # AGENT.md and CODING.md are loaded via the prompt; the agent reads them itself.
    CONTEXT_PREFIX="Read AGENT.md and CODING.md in full before making any changes. "
    if [[ "$PLAN_MODE" == true ]]; then
      PROMPT="${CONTEXT_PREFIX}Read $SPEC_FILE. Write an implementation plan to $PLAN_FILE using the Plan Mode section format in AGENT.md. Do not write any code. After writing the plan, output a summary and stop.${PLAN_SUFFIX}"
    elif [[ "$HAS_APPROVED_PLAN" == true ]]; then
      PROMPT="${CONTEXT_PREFIX}The approved plan in $APPROVED_PLAN_FILE has been reviewed and approved. Check $PROGRESS_FILE for a progress log — if present, read the completed files to confirm their state and continue from where the previous session left off; otherwise start fresh. Maintain $PROGRESS_FILE throughout: append a progress entry after each file. After all files are implemented, run '$TEST_CMD' and fix any failing tests and rerun only until they pass -- if the initial run already passes, do not run the full suite again. List all files changed and paste the final test output when done.${SUFFIX}"
    else
      PROMPT="${CONTEXT_PREFIX}Implement $SPEC_FILE. Maintain $PROGRESS_FILE throughout: append a progress entry after completing each file. After all files are implemented, run '$TEST_CMD' and fix any failing tests and rerun only until they pass -- if the initial run already passes, do not run the full suite again. List all files changed and paste the final test output when done.${SUFFIX}"
    fi
    echo "Running: claude (new subprocess — isolated context)"
    echo ""
    claude "$PROMPT"
    ;;

  *)
    echo "Unknown tool: $TOOL"
    echo "Use --tool codex, gemini, aider, or claude"
    exit 1
    ;;
esac
